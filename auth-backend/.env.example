# Blumax Auth -- Phase 1 standalone service. Dev/local only; not connected
# to Core's production database, Redis, or signing key in any way.

DATABASE_URL=postgresql+asyncpg://authuser:authpass@postgres:5432/blumax_auth
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development

# RS256 signing key. Leave JWT_PRIVATE_KEY empty in development -- a
# throwaway dev key is generated once and cached at JWT_DEV_KEY_PATH.
# Production refuses to start without a real JWT_PRIVATE_KEY set (see
# app/core/keys.py). This dev key is NEVER Core's real production key and
# NEVER should be -- see MIGRATION.md for how the real key transplant
# happens, later, deliberately, as its own approved step.
JWT_PRIVATE_KEY=
JWT_DEV_KEY_PATH=.dev-keys/auth-jwt-private.pem
JWT_PREVIOUS_PUBLIC_KEY=

# Deliberately different from Core's own issuer/audience for Phase 1, so a
# Blumax-Auth-issued token is never mistaken for a Core-issued one while
# both exist side by side. The real cutover (a later phase) is a decision
# about whether to adopt Core's exact iss/aud or keep these -- not made
# here, see MIGRATION.md.
JWT_ISSUER=https://auth.blumax.health
JWT_AUDIENCE=blumax

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# "closed" (default) = if Redis is unreachable, treat an access token as
# revoked rather than silently honouring it -- see
# app/core/session_revocation.py's own docstring for why this differs
# from Core's current fail-open behavior (a named finding in the prior
# audit, addressed here, not in Core).
SESSION_REVOCATION_FAIL_MODE=closed

# --- Phase 5: service-to-service authentication, SSO, password reset -----
SERVICE_TOKEN_EXPIRE_MINUTES=10
SSO_CODE_TTL_SECONDS=60
# Comma-free JSON-array-style list is not how pydantic-settings reads a
# list[str] from a plain env var -- use a JSON array string, e.g.
# SSO_PUBLIC_CONSUME_DESTINATION_APPS=["admin","doctor"]. Empty by
# default: an operator must opt a destination into the public,
# no-service-account consume path explicitly.
SSO_PUBLIC_CONSUME_DESTINATION_APPS=[]
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_MIN_LENGTH=8
